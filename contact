<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Contact the HireLens team with questions about resume screening, scoring or your account.">
  <title>Contact | HireLens</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
    <h2>HireLens</h2>
    <nav>
      <a href="index.html">Home</a> |
      <a href="media.html">Media</a> |
      <a href="services.html">Services</a> |
      <a href="portfolio.html">Portfolio</a> |
      <a href="contact.html">Contact</a> |
      <a href="register.html">Register</a>
    </nav>
    <hr>
  </header>

  <main>

    <section>
      <p><small>Talk to the team</small></p>
      <h1>Contact us</h1>
      <p>Have a question about resume screening, how scores are built, or your account? Send us a message and we will get back to you.</p>
    </section>

    <hr>

    <section>
      <h2>Send a message</h2>

      <form action="#" method="post">

        <p>
          <label for="name">Full name</label><br>
          <input type="text" id="name" name="name" placeholder="Ayesha Khan" required>
        </p>

        <p>
          <label for="email">Email</label><br>
          <input type="email" id="email" name="email" placeholder="you@company.com" required>
        </p>

        <p>
          <label for="topic">Topic</label><br>
          <select id="topic" name="topic" required>
            <option value="" selected disabled>Select a topic</option>
            <option value="scoring">How scoring works</option>
            <option value="services">Services</option>
            <option value="account">My account</option>
            <option value="other">Other</option>
          </select>
        </p>

        <p>
          <label for="message">Message</label><br>
          <textarea id="message" name="message" rows="6" cols="50" placeholder="Write your message here" required></textarea>
        </p>

        <p>
          <input type="checkbox" id="reply" name="reply">
          <label for="reply">Send me a copy of this message.</label>
        </p>

        <p>
          <button type="submit">Send message</button>
          <button type="reset">Clear</button>
        </p>

      </form>
    </section>

    <hr>

    <section>
      <h2>Other ways to reach us</h2>
      <table border="1" cellpadding="6">
        <caption>HireLens contact details</caption>
        <thead>
          <tr>
            <th scope="col">Method</th>
            <th scope="col">Details</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Email</td>
            <td><a href="mailto:team@hirelens.example">team@hirelens.example</a></td>
          </tr>
          <tr>
            <td>Phone</td>
            <td>+00 000 0000000</td>
          </tr>
          <tr>
            <td>Address</td>
            <td>Department of Computer Science, University Campus</td>
          </tr>
          <tr>
            <td>Hours</td>
            <td>Monday to Friday, 9:00 to 17:00</td>
          </tr>
        </tbody>
      </table>
      <p>Not registered yet? <a href="register.html">Create a recruiter account</a>.</p>
    </section>

    <hr>

    <section>
      <h2>Before you write</h2>
      <p>You may find your answer on these pages:</p>
      <ul>
        <li><a href="media.html">How HireLens works</a>: steps, criteria and scoring weights</li>
        <li><a href="services.html">Services</a>: what HireLens offers</li>
        <li><a href="portfolio.html">Portfolio</a>: screening mockups</li>
      </ul>
    </section>

  </main>

  <footer>
    <hr>
    <p>HireLens, university web technologies project</p>
