<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Contact the HireLens team with questions about resume screening, scoring or your account.">
  <title>Contact | HireLens</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
    <h2>HireLens</h2>
    <nav>
      <a href="index.html">Home</a> |
      <a href="media.html">Media</a> |
      <a href="services.html">Services</a> |
      <a href="portfolio.html">Portfolio</a> |
      <a href="contact.html">Contact</a> |
      <a href="register.html">Register</a>
    </nav>
    <hr>
  </header>

  <main>

    <section>
      <p><small>Talk to the team</small></p>
      <h1>Contact us</h1>
      <p>Have a question about resume screening, how scores are built, or your account? Send us a message and we will get back to you.</p>
    </section>

    <hr>

    <section>
      <h2>Send a message</h2>

      <form action="#" method="post">

        <p>
          <label for="name">Full name</label><br>
          <input type="text" id="name" name="name" placeholder="Ayesha Khan" required>
        </p>

        <p>
          <label for="email">Email</label><br>
          <input type="email" id="email" name="email" placeholder="you@company.com" required>
        </p>

        <p>
          <label for="topic">Topic</label><br>
          <select id="topic" name="topic" required>
            <option value="" selected disabled>Select a topic</option>
            <option value="scoring">How scoring works</option>
            <option value="services">Services</option>
            <option value="account">My account</option>
            <option value="other">Other</option>
          </select>
        </p>
