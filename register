<!DOCTYPE html>
<html>
<head>
 
  <title>Register | HireLens</title>
</head>
<body>

  <header>
    <h2>HireLens</h2>
    <nav>
      <a href="index.html">Home</a> |
      <a href="media.html">Media</a> |
      <a href="services.html">Services</a> |
      <a href="portfolio.html">Portfolio</a> |
      <a href="contact.html">Contact</a> |
      <a href="register.html">Register</a>
    </nav>
    <hr>
  </header>

  <main>

    <section>
      <p><small>Recruiter account</small></p>
      <h1>Create your HireLens account</h1>
      <p>Set up an account to upload resumes, paste a job description and get ranked candidates with a score breakdown.</p>
      <ul>
        <li>See matched and missing skills for every candidate</li>
        <li>Use blind review to hide names and contact details</li>
        <li>Rank a batch of resumes in minutes</li>
      </ul>
    </section>

    <hr>

    <section>
      <h2>Register</h2>

      <form action="#" method="post">

        <p>
          <label for="first-name">First name</label><br>
          <input type="text" id="first-name" name="first_name" placeholder="ali" required>
        </p>

        <p>
          <label for="last-name">Last name</label><br>
          <input type="text" id="last-name" name="last_name" placeholder="Khan" required>
        </p>

        <p>
          <label for="email">Work email</label><br>
          <input type="email" id="email" name="email" placeholder="you@company.com" required>
        </p>

        <p>
          <label for="company">Company</label><br>
          <input type="text" id="company" name="company" placeholder="Company name">
        </p>

        <p>
          <label for="role">Your role</label><br>
          <select id="role" name="role" required>
            <option value="" selected disabled>Select a role</option>
            <option value="recruiter">Recruiter</option>
            <option value="hiring-manager">Hiring manager</option>
            <option value="hr">HR generalist</option>
            <option value="other">Other</option>
          </select>
        </p>

        <p>
          <label for="password">Password</label><br>
          <input type="password" id="password" name="password" minlength="8" placeholder="At least 8 characters" required><br>
          <small>Use 8 or more characters.</small>
        </p>

        <p>
          <label for="confirm">Confirm password</label><br>
          <input type="password" id="confirm" name="confirm" minlength="8" placeholder="Repeat password" required>
        </p>

        <p>
          <input type="checkbox" id="terms" name="terms" required>
          <label for="terms">I agree to the <a href="#">terms of use</a> and <a href="#">privacy policy</a>.</label>
        </p>

        <p>
          <button type="submit">Create account</button>
        </p>

      </form>

      <p>Questions first? <a href="contact.html">Talk to the team</a></p>
    </section>

  </main>

  <footer>
    <hr>
    <p>HireLens, university web technologies project</p>
    <nav>
      <a href="index.html">Home</a> /
      <a href="media.html">Media</a> /
      <a href="register.html">Register</a> /
      <a href="services.html">Services</a> /
      <a href="portfolio.html">Portfolio</a> /
      <a href="contact.html">Contact</a>
    </nav>
  </footer>

</body>
</html>
